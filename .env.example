# ── Required ────────────────────────────────────────────────────────────────
# LLM used by the paperless-sync extractor to turn purchase-order PDFs into
# SET_COMMITMENT actions. An empty base URL selects the Anthropic API.
PAPERLESS_AI_BASE_URL=https://openrouter.ai/api/v1
PAPERLESS_AI_MODEL=openai/gpt-oss-120b
PAPERLESS_AI_API_KEY=

# The published ledger package the reactor and Connect load at startup.
# Pin the exact version — bare names silently follow dist-tags.
UMH_LEDGER_PACKAGE=umh-production-ledger
UMH_LEDGER_VERSION=0.0.11

# ── Optional (defaults shown) ───────────────────────────────────────────────
# One compatibility set — move these together.
PH_IMAGE_TAG=v6.2.3-dev.49
# A registry that serves the piece endpoints. Containers cannot reach
# "localhost", so a local one is host.docker.internal.
#PH_REGISTRY_URL=https://registry.dev.vetra.io

# Host ports. Connect's default-drive URL follows SWITCHBOARD_HOST_PORT.
#PAPERLESS_HOST_PORT=8000
#CONNECT_HOST_PORT=3000
#SWITCHBOARD_HOST_PORT=4001
#PGBOUNCER_HOST_PORT=5432

# Webhook shared secret between Paperless and the reactor.
#PAPERLESS_WEBHOOK_SECRET=local-dev-webhook-secret-not-for-production

# ── Optional: purchase orders by email ──────────────────────────────────────
# Imports PDFs from Gmail mail with the label "paperless". Setup: see README.
PAPERLESS_MAIL_ENABLED=false
PAPERLESS_MAIL_ADDRESS=
# Google app password, not your normal password. No spaces.
PAPERLESS_MAIL_APP_PASSWORD=

# Gmail label to read
#PAPERLESS_MAIL_FOLDER=paperless
# Label added after import
#PAPERLESS_MAIL_DONE_LABEL=paperless-imported
# Ignore mail older than this many days
#PAPERLESS_MAIL_MAX_AGE_DAYS=7
# Only mail from this sender / with this in the subject
#PAPERLESS_MAIL_FROM=
#PAPERLESS_MAIL_SUBJECT=
# How often to check. Keep the quotes.
#PAPERLESS_MAIL_CHECK_CRON="* * * * *"
# Other IMAP providers. Security: ssl, starttls or none.
#PAPERLESS_MAIL_IMAP_SERVER=imap.gmail.com
#PAPERLESS_MAIL_IMAP_PORT=993
#PAPERLESS_MAIL_IMAP_SECURITY=


# Factory ERP. "manual" = orders come only from approved ledgers (this demo).
# "auto" restores the simulator's fake ERP, which mints a random order every
# SIMULATOR_ERP_AUTO_ORDER_INTERVAL_MS up to a backlog of SIMULATOR_ERP_MAX_BACKLOG.
#SIMULATOR_ERP_MODE=manual

# Register umh-core with the UMH management console (cloud). The placeholder
# keeps everything local-only working.
#UMH_AUTH_TOKEN=
